// Firestore Security Rules for Financial Resume
//
// Deploy with: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User data — fully private ────────────────────────────────────────────
    // Each signed-in user can only read/write their own top-level document
    // and any sub-collections beneath it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Block everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
